# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (PostgreSQL or SQLite for local dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mwenyenyumba"
# For SQLite async testing, use: sqlite+aiosqlite:///./mwenyenyumba.db

# JWT Security
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

