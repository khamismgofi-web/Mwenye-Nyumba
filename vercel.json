{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,src/**,tests/**,dist/**,alembic/**,public/**,*.md}"
    }
  },
  "crons": [{ "path": "/api/v1/internal/overdue", "schedule": "0 3 * * *" }]
}
